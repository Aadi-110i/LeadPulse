# LeadPulse API — copy to server/.env and adjust for your machine.
# Every value below is a development default; nothing here is a real secret.

# PostgreSQL connection string.
DATABASE_URL=postgres://leadpulse:leadpulse@127.0.0.1:5433/leadpulse

# Redis connection string. BullMQ requires Redis 6.2 or newer.
REDIS_URL=redis://127.0.0.1:6380

# API port.
PORT=3000

# Secret used to sign session tokens. Change this for any real deployment.
JWT_SECRET=leadpulse_dev_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Delay, in seconds, before a follow-up job is handed to the queue.
FOLLOWUP_DELAY_SECONDS=5

# Sender identity recorded on outbound follow-ups.
WHATSAPP_SENDER=+14155550100

# Not read by the app today. The summariser and the WhatsApp sender are both
# simulated behind swappable providers — set these when you wire up the real
# ones and drop them into server/src/services/.
# OPENAI_API_KEY=sk-proj-...
# TWILIO_AUTH_TOKEN=...
