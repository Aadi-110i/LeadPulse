{
  "name": "leadpulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "worker": "node server/src/workers/followupWorker.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "migrate": "node server/src/db/migrate.js",
    "seed": "node server/src/db/seed.js",
    "db:setup": "npm run migrate && npm run seed",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:api": "node scripts/api-smoke.mjs",
    "test:ui": "node scripts/verify.mjs",
    "verify": "npm run lint && npm run test:api && npm run test:ui"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.14.0",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "puppeteer-core": "^25.16.0",
    "vite": "^8.0.10"
  }
}
